NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Must match the origin users open (no path or trailing slash).
APP_URL=http://localhost:3000

# Optional override for the RevenueCat setup guide link.
NEXT_PUBLIC_REVENUECAT_SETUP_URL=

# Server-only key: required for verified marketplace publishing and sponsorship checkout.
# Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SECRET_KEY=
# Sponsorship checkout. Use Stripe test credentials and a separate Supabase database for testing.
STRIPE_SECRET_KEY=
STRIPE_SPONSOR_PRICE_ID=
STRIPE_SPONSOR_WEBHOOK_SECRET=
